# =============================================================================
# .gitignore — Business-management-website
# =============================================================================

# --- Environment variables (NEVER commit these) ------------------------------
.env
.env.*
!.env.example

# --- Dependencies ------------------------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build outputs -----------------------------------------------------------
dist/
build/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# --- Logs --------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Coverage / test artifacts -----------------------------------------------
coverage/
.nyc_output/

# --- OS files ----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor / IDE -----------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# --- Uploads / user data (if stored locally during dev) ----------------------
backend/uploads/
backend/tmp/

# --- Render / Vercel platform caches ----------------------------------------
.vercel/
.render/
